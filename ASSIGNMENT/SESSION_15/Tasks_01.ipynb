   "source": [
    "## Safe Division"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "be64bc2c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "5.0\n",
      "Cannot divide by zero\n"
     ]
    }
   ],
   "source": [
    "def safe_divide(a, b): \n",
    "    try: \n",
    "        return a / b \n",
    "    except ZeroDivisionError: \n",
    "        return \"Cannot divide by zero\" \n",
    "    \n",
    "print(safe_divide(10, 2)) \n",
    "print(safe_divide(10, 0))"
   ]
  }
 ],
