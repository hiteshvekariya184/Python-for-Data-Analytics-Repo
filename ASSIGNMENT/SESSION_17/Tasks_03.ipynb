    "## Display Day of the Week"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "5c0476d6",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Day for 2026-10-3: Saturday\n"
     ]
    }
   ],
   "source": [
    "from datetime import datetime\n",
    "\n",
    "date_input = input(\"Enter date (YYYY-MM-DD): \")\n",
    "\n",
    "date_object = datetime.strptime(date_input, \"%Y-%m-%d\")\n",
    "\n",
    "day = date_object.strftime(\"%A\")\n",
    "\n",
    "print(f\"Day for {date_input}: {day}\")"
   ]
  }
