   "source": [
    "import os\n",
    "\n",
    "files = os.listdir(\"Images\")\n",
    "\n",
    "print(\"Image files:\")\n",
    "\n",
    "for file in files:\n",
    "    if file.lower().endswith((\".jpg\", \".png\")):\n",
    "        print(file)"
   ]
