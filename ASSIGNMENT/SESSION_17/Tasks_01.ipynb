   ],
   "source": [
    "import math\n",
    "\n",
    "num = 25\n",
    "\n",
    "square_root = math.sqrt(num)\n",
    "factorial = math.factorial(num)\n",
    "pi_value = math.pi\n",
    "\n",
    "print(\"Number:\", num)\n",
    "print(\"Square Root:\", square_root)\n",
    "print(\"Factorial:\", factorial)\n",
    "print(\"Value of Pi:\", pi_value)"
   ]
  }
