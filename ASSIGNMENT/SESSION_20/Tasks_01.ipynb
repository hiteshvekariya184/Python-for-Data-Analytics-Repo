   "source": [
    "class Product: \n",
    "    def __init__(self, price): \n",
    "        self._price = price \n",
    "    \n",
    "    def display_price(self): \n",
    "        print(\"Price:\", self._price) \n",
    "        \n",
    "product = Product(500) \n",
    "product.display_price()"
   ]
  }
