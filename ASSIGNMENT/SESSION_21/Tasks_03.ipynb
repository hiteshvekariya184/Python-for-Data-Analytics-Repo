   "source": [
    "## Polymorphism with Bonus"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "14f94304",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Bonus: 2000\n",
      "Bonus: 5000\n"
     ]
    }
   ],
   "source": [
    "class Influencer: \n",
    "    def bonus(self): \n",
    "        return 2000 \n",
    "\n",
    "class BrandManager: \n",
    "    def bonus(self): \n",
    "        return 5000 \n",
    "\n",
    "def show_bonus(employee): \n",
    "    print(\"Bonus:\", employee.bonus()) \n",
    "\n",
    "show_bonus(Influencer()) \n",
    "show_bonus(BrandManager()) "
   ]
  }
