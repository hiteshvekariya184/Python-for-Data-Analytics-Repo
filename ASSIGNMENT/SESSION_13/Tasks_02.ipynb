   "source": [
    "## Sum Playlist Durations"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "d3a58d60",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Total Duration: 930 seconds\n"
     ]
    }
   ],
   "source": [
    "def sum_playlist_durations(durations): \n",
    "    if len(durations) == 0: \n",
    "        return 0 \n",
    "    return durations[0] + sum_playlist_durations(durations[1:]) \n",
    "\n",
    "durations = [210, 180, 240, 300] \n",
    "print(\"Total Duration:\", sum_playlist_durations(durations), \"seconds\")"
   ]
  }
