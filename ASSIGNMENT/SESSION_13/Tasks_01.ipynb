   "source": [
    "## Reverse a String Recursively"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "7e619918",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "olleh\n"
     ]
    }
   ],
   "source": [
    "def reverse_string(s): \n",
    "    if len(s) == 0: \n",
    "        return s \n",
    "    return reverse_string(s[1:]) + s[0] \n",
    "\n",
    "print(reverse_string(\"hello\"))"
   ]
  }
 ],
