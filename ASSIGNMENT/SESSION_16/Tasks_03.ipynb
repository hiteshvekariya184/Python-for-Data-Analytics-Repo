   "source": [
    "foods = [\"Pizza\", \"Burger\", \"Biryani\", \"Pasta\"] \n",
    "prices = [250, 150, 220, 180] \n",
    "for food, price in zip(foods, prices): \n",
    "    print(f\"{food} - ₹{price}\")"
   ]
  }
