   "source": [
    "## Cashback Generator"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "4432c369",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Cashback: ₹ 25.0\n",
      "Cashback: ₹ 50.0\n",
      "Cashback: ₹ 37.5\n",
      "Cashback: ₹ 100.0\n"
     ]
    }
   ],
   "source": [
    "def cashback_generator(transactions): \n",
    "    for amount in transactions: \n",
    "        yield amount * 0.05 \n",
    "\n",
    "transactions = [500, 1000, 750, 2000] \n",
    "\n",
    "for cashback in cashback_generator(transactions): \n",
    "    print(\"Cashback: ₹\", cashback)"
   ]
  }
 ],
