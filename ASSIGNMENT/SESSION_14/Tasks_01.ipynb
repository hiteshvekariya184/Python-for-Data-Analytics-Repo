   "source": [
    "## Write Songs to a File"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "41e89a0f",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Playlist created successfully.\n"
     ]
    }
   ],
   "source": [
    "songs = [\"Kesariya\", \"Heeriye\", \"Chaleya\", \"O Maahi\", \"Apna Bana Le\"] \n",
    "\n",
    "with open(\"my_playlist.txt\", \"w\") as file: \n",
    "    for song in songs: file.write(song + \"\\n\") \n",
    "    \n",
    "print(\"Playlist created successfully.\")"
   ]
  }
