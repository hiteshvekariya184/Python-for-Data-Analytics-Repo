   "source": [
    "## Validate Date Using re.search()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "5c969b99",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "True\n",
      "False\n"
     ]
    }
   ],
   "source": [
    "import re \n",
    "\n",
    "def check_date(text):\n",
    "    pattern = r\"\\b\\d{2}/\\d{2}/\\d{4}\\b\"\n",
    "    return bool(re.search(pattern, text))\n",
    "\n",
    "print(check_date(\"Order placed on 25/06/2024\"))\n",
    "print(check_date(\"Order placed today\"))"
   ]
  }
