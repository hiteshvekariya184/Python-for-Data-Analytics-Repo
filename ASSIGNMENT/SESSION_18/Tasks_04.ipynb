   "source": [
    "## Mask Phone Numbers Using re.sub()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "6346016b",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "My Paytm number is ******3210.\n"
     ]
    }
   ],
   "source": [
    "import re \n",
    "\n",
    "text = \"My Paytm number is 9876543210.\" \n",
    "masked = re.sub(r\"\\d{6}(\\d{4})\", r\"******\\1\", text) \n",
    "print(masked)"
   ]
  }
