   "source": [
    "## Extract Emails from Zomato Review"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "0fe273e4",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Emails: ['foodie@gmail.com', 'support@zomato.com', 'user123@yahoo.com']\n"
     ]
    }
   ],
   "source": [
    "import re \n",
    "\n",
    "text = \"\"\" Great food! Contact foodie@gmail.com or support@zomato.com. My friend: user123@yahoo.com \"\"\" \n",
    "emails = re.findall(r\"[\\w.-]+@[\\w.-]+\\.\\w+\", text) \n",
    "print(\"Emails:\", emails)"
   ]
  }
