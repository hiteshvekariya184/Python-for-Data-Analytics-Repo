   "source": [
    "## Extract Indian Phone Numbers"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "83dd2f01",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Phone Numbers: ['9876543210', '8123456789', '9123456780']\n"
     ]
    }
   ],
   "source": [
    "import re \n",
    "\n",
    "text = \"Contact 9876543210 or 8123456789. Price is 9999. Call 9123456780.\" \n",
    "phones = re.findall(r\"\\b[789]\\d{9}\\b\", text) \n",
    "print(\"Phone Numbers:\", phones)"
   ]
  }
