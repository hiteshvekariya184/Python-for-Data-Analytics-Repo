   "source": [
    "from functools import reduce \n",
    "\n",
    "orders = [120, 340, 560, 80] \n",
    "total_bill = reduce(lambda x, y: x + y, orders) \n",
    "\n",
    "print(\"Total Bill:\", total_bill)"
   ]
  }
