   "source": [
    "## Clean Spotify Song Titles Using map()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "4c15c36c",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Shape Of You', 'Blinding Lights', 'Perfect', 'Levitating']\n"
     ]
    }
   ],
   "source": [
    "songs = [ \" shape OF you \", \n",
    "         \" blinding LIGHTS\", \n",
    "         \"perfect \", \" LEVITATING\" ] \n",
    "\n",
    "cleaned_songs = list( map(lambda song: song.strip().title(), songs) ) \n",
    "\n",
    "print(cleaned_songs)"
   ]
  }
