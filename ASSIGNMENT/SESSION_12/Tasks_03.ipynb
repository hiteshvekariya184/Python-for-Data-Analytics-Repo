   "source": [
    "## Filter Flipkart Products Starting with \"S\""
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "2df90f99",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "['Samsung Galaxy', 'Shoes', 'Smart Watch', 'Speaker']\n"
     ]
    }
   ],
   "source": [
    "products = [ \"Samsung Galaxy\", \"Laptop\", \"Shoes\", \"Smart Watch\", \"Mouse\", \"Speaker\" ] \n",
    "filtered_products = list( filter(lambda product: product.lower().startswith(\"s\"), products) ) \n",
    "print(filtered_products)"
   ]
  }
