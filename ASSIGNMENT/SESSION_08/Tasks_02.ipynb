   "source": [
    "# Create the list of cricket scores\n",
    "scores = [45, 78, 102, 34, 67, 89]\n",
    "\n",
    "# Initialize index\n",
    "i = 0\n",
    "\n",
    "# Use a while loop\n",
    "while i < len(scores):\n",
    "    if scores[i] > 100:\n",
    "        break\n",
    "\n",
    "    print(scores[i])\n",
    "    i += 1"
   ]
  }
