   "source": [
    "order_amounts = [120, 250, 90, 310, 150]\n",
    "Total = 0\n",
    "\n",
    "for amounts in order_amounts:\n",
    "    Total += amounts\n",
    "\n",
    "print(\"Total Amount is : \",Total ) "
   ]
