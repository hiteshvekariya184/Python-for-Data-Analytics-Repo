   "source": [
    "# List of favorite songs\n",
    "songs = ['Kesariya', 'Believer', 'Shape of You', 'Blinding Lights', 'Excuses']\n",
    "\n",
    "# Use enumerate() to print playlist position and song name\n",
    "for position, song in enumerate(songs, start=1):\n",
    "    print(position, \"-\", song)"
   ]
  }
